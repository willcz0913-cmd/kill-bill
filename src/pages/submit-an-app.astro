---
import Base from '../layouts/Base.astro';
import { CATEGORIES, allApps } from '../lib/apps.js';
import { recentSubmissions } from '../lib/db.js';

const title = 'Submit an app · Killbill';
const description =
  'Suggest a paid app for the death list, or a free alternative that replaces one. Every submission is reviewed by hand before it goes on the site.';

const user = Astro.locals.user ?? null;

const params = Astro.url.searchParams;
const sent = params.get('sent') === '1';
const errorCode = params.get('error');
const ERRORS = {
  slow: 'Too many submissions from this connection. Give it an hour and try again.',
  missing: 'We need at least a name and a link.',
  nocat: 'Pick a category so we know where it belongs.',
  auth: 'Please sign in before submitting.',
  bad: 'Something went wrong reading that. Mind trying again?',
};
const errorMsg = errorCode ? ERRORS[errorCode] || 'Something went wrong. Try again.' : '';

const cats = Object.entries(CATEGORIES);
// Existing app names power the "what does it replace" datalist: pick one off the
// list or type a new one. Sorted so the dropdown reads alphabetically.
const appNames = allApps()
  .map((a) => a.name)
  .sort((a, b) => a.localeCompare(b));

const submissions = await recentSubmissions(60);
const catLabel = (key) => CATEGORIES[key]?.label ?? null;

// "3d ago" style stamp. Submissions are recent by nature, so days is plenty.
function ago(ms) {
  const s = Math.max(0, Math.floor((Date.now() - ms) / 1000));
  if (s < 60) return 'just now';
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return `${d}d ago`;
}

const host = (url) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
---

<Base {title} {description}>
  <main class="wrap submit-page">
    <section class="submit-hero">
      <span class="microlabel">reader submissions</span>
      <h1>Submit an app.</h1>
      <p class="sub">
        Know a paid app that belongs on the death list, or a free tool that
        already replaces one? Send it here. We check every entry by hand before
        it goes live, sponsorship never buys a verdict and this form never does
        either.
      </p>
    </section>

    <section class="submit-form-wrap" id="form">
      {sent && (
        <p class="submit-banner ok" role="status">
          Got it, thanks. We review submissions by hand, so give it a few days.
        </p>
      )}
      {errorMsg && (
        <p class="submit-banner err" role="status">{errorMsg}</p>
      )}

      {user ? (
        <form class="submit-form" method="post" action="/api/submit-app" data-astro-reload>
          <label class="hp" aria-hidden="true">
            Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <div class="sf-field">
            <label for="sf-name">Name <span class="req">*</span></label>
            <input type="text" id="sf-name" name="name" required maxlength="80" placeholder="Granola, AppFlowy, etc." />
          </div>

          <div class="sf-field">
            <label for="sf-url">Link <span class="req">*</span></label>
            <input type="text" id="sf-url" name="url" required maxlength="200" placeholder="granola.ai" inputmode="url" />
            <span class="sf-hint">The homepage. We pull the logo from it. For an open-source tool, its site or repo.</span>
          </div>

          <div class="sf-field">
            <label for="sf-alt">What does it replace?</label>
            <div class="combo" data-combo="free" data-placeholder="the paid app it kills, e.g. Notion">
              <input
                type="text"
                id="sf-alt"
                name="alternativeTo"
                maxlength="80"
                list="sf-apps"
                autocomplete="off"
                placeholder="the paid app it kills, e.g. Notion"
              />
              <datalist id="sf-apps">
                {appNames.map((n) => <option value={n} />)}
              </datalist>
            </div>
            <span class="sf-hint">
              Type to search the list, or name any paid app it stands in for.
            </span>
          </div>

          <div class="sf-field">
            <label for="sf-cat">Category <span class="req">*</span></label>
            <div class="combo" data-combo="select" data-placeholder="search categories">
              <select id="sf-cat" name="category" aria-label="Category" required>
                <option value="">pick one</option>
                {cats.map(([key, meta]) => (
                  <option value={key}>{meta.emoji} {meta.label}</option>
                ))}
              </select>
            </div>
            <span class="sf-hint">Where it belongs. Required, it's how we file and show it.</span>
          </div>

          <div class="sf-field">
            <label for="sf-pitch">One line</label>
            <input
              type="text"
              id="sf-pitch"
              name="pitch"
              maxlength="240"
              placeholder="What it is, or why it's a real free replacement."
            />
          </div>

          <div class="sf-field">
            <label for="sf-email">Your email</label>
            <input type="email" id="sf-email" name="email" maxlength="254" placeholder="optional, so we can follow up" />
            <span class="sf-hint">Only used to reach you about this submission. Never shown here.</span>
          </div>

          <button class="btn primary" type="submit">send it in →</button>

          <p class="sf-foot">
            Rather open a pull request? The death list is
            <a href="https://github.com/kirtirajsinh/kill-bill/blob/main/CONTRIBUTING.md">
              JSON in the repo
            </a>, one file per app.
          </p>
        </form>
      ) : (
        <div class="submit-gate">
          <p class="submit-gate-line">Submissions are open to signed-in accounts, one quick sign in and you're set.</p>
          <a class="btn primary" href="/signin" data-signin>sign in to submit →</a>
          <p class="sf-foot">
            Prefer a pull request instead? The death list is
            <a href="https://github.com/kirtirajsinh/kill-bill/blob/main/CONTRIBUTING.md">
              JSON in the repo
            </a>, no account needed.
          </p>
        </div>
      )}
    </section>

    <section class="submit-recent">
      <div class="list-head">
        <h2>Recently suggested</h2>
        <span class="note">community submissions, unverified until we review them</span>
      </div>

      {submissions.length === 0 ? (
        <p class="submit-empty">Nothing yet. Be the first, add one above.</p>
      ) : (
        <ul class="sub-list">
          {submissions.map((s) => (
            <li class="sub-item">
              <div class="sub-main">
                <a class="sub-name" href={s.url} target="_blank" rel="nofollow noopener ugc">
                  {s.name}
                </a>
                <span class="sub-host">{host(s.url)}</span>
                {s.alternativeTo && (
                  <span class="sub-alt">replaces {s.alternativeTo}</span>
                )}
              </div>
              {s.pitch && <p class="sub-pitch">{s.pitch}</p>}
              <div class="sub-meta">
                {catLabel(s.category) && <span class="sub-cat">{catLabel(s.category)}</span>}
                <span class="sub-when">{ago(s.createdAt)}</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Base>

<script is:inline src={`/js/combo.js?v=${__BUILD_ID__}`} defer></script>

<style>
  .submit-page {
    padding-bottom: 80px;
  }

  .submit-hero {
    padding: 24px 0 8px;
  }

  .submit-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 10px 0 0;
  }

  .submit-hero .sub {
    max-width: 60ch;
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  .submit-form-wrap {
    margin-top: 28px;
    max-width: 640px;
  }

  .submit-banner {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    border: 1px solid var(--border);
  }

  .submit-banner.ok {
    border-color: color-mix(in srgb, var(--primary) 45%, transparent);
    color: var(--primary);
  }

  .submit-banner.err {
    border-color: color-mix(in srgb, var(--no-fg, #ff4444) 50%, transparent);
    color: var(--no-fg, #ff4444);
  }

  .submit-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sf-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .sf-field label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sf-field .req {
    color: var(--primary);
  }

  .submit-form input[type='text'],
  .submit-form input[type='email'],
  .submit-form select {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 12px 16px;
    color: var(--fg);
    font: inherit;
    font-size: 14px;
    transition: border-color 0.15s ease;
  }

  .submit-form input:focus,
  .submit-form select:focus {
    outline: none;
    border-color: var(--primary);
  }

  .submit-form input:-webkit-autofill,
  .submit-form input:-webkit-autofill:hover,
  .submit-form input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px var(--bg) inset;
    box-shadow: 0 0 0 1000px var(--bg) inset;
    -webkit-text-fill-color: var(--fg);
    caret-color: var(--fg);
  }

  .sf-hint {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.5;
  }

  .submit-form .btn.primary {
    align-self: flex-start;
    margin-top: 4px;
  }

  .sf-foot {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
    padding-top: 4px;
  }

  .submit-gate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .submit-gate-line {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg);
  }

  .submit-recent {
    margin-top: 56px;
  }

  .submit-empty {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .sub-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .sub-item {
    padding: 18px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sub-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .sub-main {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .sub-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
  }

  .sub-name:hover {
    color: var(--primary);
  }

  .sub-host {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .sub-alt {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 35%, transparent);
    border-radius: 100px;
    padding: 2px 10px;
  }

  .sub-pitch {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 70ch;
  }

  .sub-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .sub-cat {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .submit-form .btn.primary {
      align-self: stretch;
      text-align: center;
    }
  }
</style>
